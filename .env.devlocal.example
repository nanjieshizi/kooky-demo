# 仅 npm run dev:local / electron:dev:local（vite --mode devlocal）
# 本地直连 Gateway：请求会去掉 /kooky-api，并把 /api/langgraph-compat/ 改写为 /api/（等同 deer-flow nginx rewrite）
VITE_LOCAL_GATEWAY_URL=http://localhost:8001
# Authorization: Bearer …（并保留 one_dev_token）；敏感值请用 .env.devlocal.local
VITE_LOCAL_AUTH_TOKEN=
